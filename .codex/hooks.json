{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .codex/scripts/block-python3.ps1"
          }
        ]
      },
      {
        "matcher": "request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .codex/scripts/notify.ps1 -Message \"Codex needs your input\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .codex/scripts/notify.ps1",
            "async": true
          }
        ]
      }
    ]
  }
}
