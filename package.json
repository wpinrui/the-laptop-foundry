{
  "name": "the-laptop-foundry",
  "version": "0.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "wpinrui",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs && node scripts/fetch-voice.mjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "prepreview": "node scripts/ensure-electron.mjs && node scripts/fetch-voice.mjs",
    "preview": "electron-vite preview",
    "voice": "node scripts/fetch-voice.mjs",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@ghostery/adblocker-electron": "^2.18.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.51.0",
    "mp4-muxer": "5.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sherpa-onnx-node": "1.13.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "resolutions": {
    "vite": "^7.0.0"
  }
}
